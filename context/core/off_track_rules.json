{
  "rules": [
    {
      "id": "no_revenue_30d",
      "severity": "critical",
      "enabled": true,
      "check": "no_revenue_since",
      "params": {
        "after_date": "2026-06-01",
        "window_days": 30
      },
      "message": "No revenue logged in the last 30 days. First-revenue phase is stalling \u2014 ship and invoice."
    },
    {
      "id": "habit_drift_7d",
      "severity": "warn",
      "enabled": true,
      "check": "non_negotiable_completion_below",
      "params": {
        "threshold_pct": 60,
        "window_days": 7
      },
      "message": "Non-negotiable completion has dropped under 60% over the last 7 days. Discipline is drifting."
    },
    {
      "id": "annual_target_critical",
      "severity": "critical",
      "enabled": true,
      "check": "annual_target_status",
      "params": {
        "status": "critical"
      },
      "message": "At least one annual target is in critical status. Re-plan or re-sequence before the gap compounds."
    },
    {
      "id": "syllabus_weak_before_exam",
      "severity": "warn",
      "enabled": true,
      "check": "syllabus_weak_before_exam",
      "params": {
        "days": 60,
        "min_topics": 1
      },
      "message": "Red or yellow syllabus topics remain with an exam inside 60 days. Revise them before anything else academic."
    },
    {
      "id": "payment_overdue_14d",
      "severity": "critical",
      "enabled": true,
      "check": "payment_overdue",
      "params": {
        "days": 14
      },
      "message": "A client payment is more than 14 days overdue. Chase it today."
    },
    {
      "id": "outreach_stalled",
      "severity": "warn",
      "enabled": true,
      "check": "no_outreach_sent",
      "params": {
        "window_days": 7,
        "min_qualified": 3
      },
      "message": "At least 3 qualified leads but nothing sent in 7 days. Prospecting is stalling."
    },
    {
      "id": "projects_blocked",
      "severity": "warn",
      "enabled": true,
      "check": "projects_blocked",
      "params": {
        "min": 2
      },
      "message": "Two or more projects are blocked. Clear a bottleneck before starting anything new."
    },
    {
      "id": "application_at_risk",
      "severity": "critical",
      "enabled": true,
      "check": "application_at_risk",
      "params": {
        "days": 14
      },
      "message": "An application deadline is inside 14 days with requirements still missing."
    }
  ]
}
